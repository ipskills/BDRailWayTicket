# ---- Gmail sender account (emails are sent FROM this address) ----
# Create a 16-char App Password (NOT your normal password):
#   https://myaccount.google.com/apppasswords  (needs 2-Step Verification on)
GMAIL_ADDRESS=youraddress@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Optional SMTP overrides (defaults are Gmail's)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ---- Where alerts are delivered ----
# Leave blank to auto-use the email on your Bangladesh Railway profile.
NOTIFY_EMAIL=

# ---- Railway auth ----
# Easiest for the monitor: paste a Bearer token copied from the site.
# Browser: F12 > Network > any request > Authorization header > text after "Bearer ".
# Tokens expire; re-grab when searches start failing with "Not logged in".
RAILWAY_AUTH_TOKEN=
# Optional convenience for the OTP login flow:
RAILWAY_MOBILE=

# ---- Monitor behaviour ----
# Keep this polite (>= 30) to avoid rate limits / IP bans.
POLL_INTERVAL_SECONDS=60
# Re-send a reminder every N minutes while seats remain (0 = email once).
REALERT_MINUTES=0
