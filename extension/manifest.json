{
  "manifest_version": 3,
  "name": "BD Railway Auto Seat Selector",
  "version": "1.0",
  "description": "Fetches user profile and auto-selects seats on Bangladesh Railway",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["https://eticket.railway.gov.bd/*", "https://railspaapi.shohoz.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
